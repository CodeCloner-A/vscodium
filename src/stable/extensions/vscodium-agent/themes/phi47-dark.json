  "tokenColors": [
    {
      "name": "Kommentare",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#5F6672", "fontStyle": "italic" }
    },
    {
      "name": "Schlüsselwörter, Speicher, Operatoren",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "keyword.operator.new", "keyword.operator.expression", "constant.language"],
      "settings": { "foreground": "#E0B84A" }
    },
    {
      "name": "Operatoren, Interpunktion",
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#9AA1AE" }
    },
    {
      "name": "Zeichenketten",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#8FBF6F" }
    },
    {
      "name": "Zahlen, Konstanten",
      "scope": ["constant.numeric", "constant.character", "constant.other"],
      "settings": { "foreground": "#E5A06E" }
    },
    {
      "name": "Funktionen, Methoden",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "#EDE3CB" }
    },
    {
      "name": "Typen, Klassen",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#7FB2E5" }
    },
    {
      "name": "Variablen",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#C8CCD4" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#B7BDC8", "fontStyle": "italic" }
    },
    {
      "name": "Eigenschaften, Objektschlüssel",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#C8A0D8" }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#E0B84A" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#6FBFB2" }
    },
    {
      "name": "Ungültig",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#E5646E" }
    },
    {
      "name": "Markdown-Überschriften",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#EDE9DF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown-Betonung",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E0B84A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown-Kursiv",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown-Code, Links",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.underline.link"],
      "settings": { "foreground": "#6FBFB2" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#8FBF6F" }
    },
    {
      "name": "Diff entfernt",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E5646E" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#B7BDC8",
    "property": "#C8A0D8",
    "type": "#7FB2E5",
    "class": "#7FB2E5",
    "function": "#EDE3CB",
    "method": "#EDE3CB",
    "keyword": "#E0B84A",
    "string": "#8FBF6F",
    "number": "#E5A06E",
    "comment": "#5F6672",
    "variable.readonly": "#C8CCD4"
  }
}
